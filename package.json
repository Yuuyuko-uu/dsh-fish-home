{
  "name": "dsh-fish-home",
  "version": "0.0.4",
  "description": "鱼鱼窝：把「大肥鱼的小日子」那个 3D 房间接进 DSH —— 房间里打字能送到会话里，会话里回的话、她自己打的字，都顺着事件流回到房间里。",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2"
  },
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "author": "Yuuyuko-uu (https://github.com/Yuuyuko-uu)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yuuyuko-uu/dsh-fish-home.git"
  },
  "homepage": "https://github.com/Yuuyuko-uu/dsh-fish-home#readme",
  "bugs": {
    "url": "https://github.com/Yuuyuko-uu/dsh-fish-home/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "three-js",
    "room"
  ]
}
